// ztOS App Store (ztstore): the phone's owner may install signed packages from
// the repos without a password, as the Updates app may. A package built from
// the AUR, or taking an app off the phone, asks for the person's password
// through ztos-polkit-agent: either could change anything. Only from the
// active session on the phone itself (not over SSH), only members of wheel,
// and each person can only start their own unit (its name carries theirs).
polkit.addRule(function (action, subject) {
	if (action.id != "org.freedesktop.systemd1.manage-units" ||
	    action.lookup("verb") != "start" ||
	    !subject.local || !subject.active || !subject.isInGroup("wheel")) {
		return polkit.Result.NOT_HANDLED;
	}
	var unit = action.lookup("unit");
	if (unit == "ztstore-install@" + subject.user + ".service") {
		return polkit.Result.YES;
	}
	if (unit == "ztstore-admin@" + subject.user + ".service") {
		return polkit.Result.AUTH_SELF;
	}
	return polkit.Result.NOT_HANDLED;
});
